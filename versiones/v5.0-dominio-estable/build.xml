<?xml version="1.0" encoding="UTF-8"?>
<project name="TucanGo-v5.0-DominioEstable" default="default" basedir=".">
    <description>TucanGo-v5.0-DominioEstable - Sistema TucanGo</description>
    <property file="nbproject/project.properties"/>

    <target name="default" depends="compile" description="Compilacion por defecto"/>

    <target name="-init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${build.test.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="clean" description="Limpia archivos compilados">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="-init" description="Compila el codigo fuente">
        <javac srcdir="${src.dir}"
               destdir="${build.classes.dir}"
               includeantruntime="false"
               encoding="${source.encoding}"
               source="${javac.source}"
               target="${javac.target}"
               debug="true">
            <classpath>
                <pathelement path="${javac.classpath}"/>
            </classpath>
        </javac>
    </target>
    
    <target name="compile-test" depends="compile" description="Compila los tests unitarios">
        <javac srcdir="${test.src.dir}"
               destdir="${build.test.classes.dir}"
               includeantruntime="false"
               encoding="${source.encoding}"
               source="${javac.source}"
               target="${javac.target}"
               debug="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${file.reference.junit-platform-console-standalone-1.10.2.jar}"/>
            </classpath>
        </javac>
    </target>

    <target name="test" depends="compile-test" description="Ejecuta la suite de pruebas JUnit 5">
        <path id="test.scan.path">
            <pathelement location="${build.classes.dir}"/>
            <pathelement location="${build.test.classes.dir}"/>
        </path>
        <pathconvert property="test.scan.path.converted" refid="test.scan.path" pathsep="${path.separator}"/>
        <java jar="${file.reference.junit-platform-console-standalone-1.10.2.jar}" fork="true" failonerror="true">
            <arg value="--class-path"/>
            <arg value="${test.scan.path.converted}"/>
            <arg value="--scan-class-path"/>
        </java>
    </target>

    <target name="run" depends="compile" description="Ejecuta el programa">
        <java classname="${main.class}" fork="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement path="${javac.classpath}"/>
            </classpath>
        </java>
    </target>

    <target name="jar" depends="compile" description="Genera el archivo JAR ejecutable">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>
</project>
