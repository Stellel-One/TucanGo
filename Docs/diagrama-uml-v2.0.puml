@startuml TucanGo_v2_0
skinparam classAttributeIconSize 0
skinparam style strictuml
skinparam handwritten false
skinparam monochrome false
skinparam packageStyle rectangle

title TucanGo — Diagrama de Clases UML v2.0 (Lógica y Algoritmos II)

abstract class Usuario {
    # identificacion : String
    # nombre : String
    # telefono : String
    + registrarse() : Boolean
    + iniciarSesion() : Boolean
}

class Estudiante {
    - codigoEstudiantil : String
    + solicitarViaje(origen: String, destino: String) : Boolean
    + marcarLlegadaSegura(codigoViaje: String) : Boolean
}

class Motorista {
    - placa : String
    - soatVigente : Boolean
    - disponible : Boolean
    + aceptarViaje(codigoViaje: String) : Boolean
    + registrarDisponibilidad(estado: Boolean) : Void
    + verificarDocumentos() : Boolean
}

enum EstadoViaje {
    SOLICITADO
    ACEPTADO
    EN_CURSO
    FINALIZADO
    CANCELADO
}

class Viaje {
    - codigoViaje : String
    - origen : String
    - destino : String
    - tarifa : Double
    - estado : EstadoViaje
    - fechaHora : String
    + calcularTarifa() : Double
    + iniciarViaje() : Void
    + finalizarViaje() : Void
    + cancelarViaje() : Void
}

class Calificacion {
    - puntaje : Integer
    - comentario : String
    - emisor : String
    + registrarCalificacion(puntaje: Integer, comentario: String) : Void
    + obtenerPuntaje() : Integer
}

class Pago {
    - valor : Double
    - estado : String
    - metodoPago : String
    + registrarPago(valor: Double, metodo: String) : Void
    + confirmarPago() : Boolean
}

' Herencia (Generalización)
Usuario <|-- Estudiante
Usuario <|-- Motorista

' Relaciones y Multiplicidades
Estudiante "1" --> "0..*" Viaje : solicita >
Motorista "1" --> "0..*" Viaje : atiende >
Viaje "1" --> "0..1" Calificacion : genera >
Viaje "1" --> "1" Pago : registra >

@enduml
